# --- Passwords -------------------------------------------------------------
# Leave all three empty for local development (no sign-in).
# On Vercel all three are required; the site stays locked until they are set.
#
# SITE_PASSWORD   lets people view the calendar.
# UPLOAD_PASSWORD also lets them publish a new calendar. Must differ from SITE_PASSWORD.
# AUTH_SECRET     random string (32+ characters) used to sign sign-in cookies.
#                 Generate one with:  openssl rand -base64 48
SITE_PASSWORD=
UPLOAD_PASSWORD=
AUTH_SECRET=

# --- Storage ---------------------------------------------------------------
# On Vercel, connect a Blob store (Storage tab) and this is set for you.
# Leave empty locally: data is stored in ./.data instead.
BLOB_READ_WRITE_TOKEN=
