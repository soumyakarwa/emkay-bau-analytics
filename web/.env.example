# Copy this file to .env (which Git ignores) and fill it in. Never commit .env.

# --- Sign-in ---------------------------------------------------------------
# Leave all five empty while developing on your computer: sign-in is then off.
# On a live site all five are required, or the site stays locked.
# Use long passphrases (12+ characters), e.g. four random words. All must differ.
#
# SITE_PASSWORD           view the site (the whole team)
# UPLOAD_PASSWORD_GLOBAL  also upload Emkay Global's workbook
# UPLOAD_PASSWORD_IM      also upload Emkay Investment Managers' workbook
# UPLOAD_PASSWORD_WEALTH  also upload Emkay Wealth Management's workbook
# AUTH_SECRET             random string (32+ characters) that signs sign-in cookies.
#                         Generate one with:  openssl rand -base64 48
SITE_PASSWORD=
UPLOAD_PASSWORD_GLOBAL=
UPLOAD_PASSWORD_IM=
UPLOAD_PASSWORD_WEALTH=
AUTH_SECRET=

# --- Data ------------------------------------------------------------------
# Where published uploads are kept on this computer (default: .data).
BAU_DATA_DIR=
